{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/*.ts", "vitest.config.ts", "stryker.config.mjs"] },
    "packages/*": { "entry": ["src/index.ts", "src/*.ts", "test/**/*.test.ts", "test-int/**/*.test.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "services/*": { "entry": ["src/index.ts", "src/main.ts", "test/**/*.test.ts", "test-int/**/*.test.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "apps/*": { "entry": ["src/main.ts*", "src/index.ts", "test/**/*.test.ts*"], "project": ["src/**/*.ts*"] },
    "tools/*": { "entry": ["src/*.ts", "test/**/*.test.ts"], "project": ["src/**/*.ts", "test/**/*.ts"] },
    "tests/*": { "entry": ["**/*.test.ts"], "project": ["**/*.ts"] }
  }
}
