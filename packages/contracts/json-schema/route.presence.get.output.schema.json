{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "signed"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "zkpassport",
            "nfc-chip"
          ]
        },
        "lawyerNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledgerHash": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "ledgerIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "method",
        "lawyerNonce",
        "ledgerHash",
        "ledgerIndex"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
