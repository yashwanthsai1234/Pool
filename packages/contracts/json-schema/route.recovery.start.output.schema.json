{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recoveryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "slot": {
      "type": "string",
      "enum": [
        "A",
        "LA",
        "B",
        "LB"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "waiting",
        "ready",
        "cancelled",
        "done"
      ]
    },
    "readyAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "recoveryId",
    "dealId",
    "slot",
    "state",
    "readyAt"
  ],
  "additionalProperties": false
}
