{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "side": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "zk-salt",
        "zk-disclosure"
      ]
    },
    "box": {
      "type": "object",
      "properties": {
        "suite": {
          "type": "string",
          "const": "hpke-xwing-v1"
        },
        "recipient_key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
        },
        "enc": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){373}[A-Za-z0-9+/]{2}==$"
        },
        "ciphertext": {
          "type": "string",
          "maxLength": 87384,
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        }
      },
      "required": [
        "suite",
        "recipient_key_id",
        "enc",
        "ciphertext"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dealId",
    "side",
    "kind",
    "box"
  ],
  "additionalProperties": false
}
