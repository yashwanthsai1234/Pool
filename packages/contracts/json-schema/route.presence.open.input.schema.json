{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "side": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "request": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "zkpassport",
            "nfc-chip"
          ]
        },
        "lawyerNonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledgerHash": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "ledgerIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "method",
        "lawyerNonce",
        "ledgerHash",
        "ledgerIndex"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "dealId",
    "side",
    "request"
  ],
  "additionalProperties": false
}
