{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "pay_bob",
        "refund_alice",
        "close",
        "ticket_create",
        "signer_list_update",
        "seal_update",
        "escrow_finish"
      ]
    },
    "unsignedTx": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "lastLedger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "complete",
        "expired",
        "void"
      ]
    },
    "signedRoles": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "alice",
          "lawyerA",
          "bob",
          "lawyerB"
        ]
      }
    }
  },
  "required": [
    "requestId",
    "dealId",
    "purpose",
    "unsignedTx",
    "lastLedger",
    "status",
    "signedRoles"
  ],
  "additionalProperties": false
}
