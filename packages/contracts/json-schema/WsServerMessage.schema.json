{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "row"
        },
        "dealId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "topic": {
          "type": "string",
          "enum": [
            "deal.event",
            "deal.state",
            "signature.request",
            "ledger.observation",
            "ledger.validated",
            "frost.session",
            "alert",
            "walkthrough.step"
          ]
        },
        "payload": {
          "type": "string",
          "maxLength": 87384,
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        }
      },
      "required": [
        "type",
        "dealId",
        "seq",
        "topic",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "FORBIDDEN",
            "OVERFLOW"
          ]
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    }
  ]
}
