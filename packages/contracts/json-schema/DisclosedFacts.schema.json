{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "firstname": {
      "type": "string",
      "maxLength": 128,
      "x-legx-secret": true
    },
    "lastname": {
      "type": "string",
      "maxLength": 128,
      "x-legx-secret": true
    },
    "birthdate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "x-legx-secret": true
    },
    "nationality": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "x-legx-secret": true
    }
  },
  "required": [
    "firstname",
    "lastname",
    "birthdate",
    "nationality"
  ],
  "additionalProperties": false
}
