{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "contract_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "LA",
        "LB"
      ]
    },
    "lawyer_pub": {
      "type": "string",
      "pattern": "^ED[0-9A-F]{64}$"
    },
    "bar_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ops_account": {
      "type": "string",
      "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$"
    },
    "verification_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sig_algs": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ed25519",
          "ml-dsa-65"
        ]
      }
    }
  },
  "required": [
    "deal_id",
    "contract_root",
    "role",
    "lawyer_pub",
    "bar_commitment",
    "ops_account",
    "verification_sha256",
    "sig_algs"
  ],
  "additionalProperties": false
}
