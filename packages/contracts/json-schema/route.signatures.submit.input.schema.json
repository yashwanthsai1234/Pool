{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "role": {
      "type": "string",
      "enum": [
        "alice",
        "lawyerA",
        "bob",
        "lawyerB"
      ]
    },
    "signerBlob": {
      "type": "string",
      "pattern": "^(?:[0-9A-F]{2}){1,10000}$"
    }
  },
  "required": [
    "dealId",
    "requestId",
    "role",
    "signerBlob"
  ],
  "additionalProperties": false
}
