{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opsAccount": {
      "type": "string",
      "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$"
    },
    "barNumber": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,32}$",
      "x-legx-secret": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "not_active",
        "not_found"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "evidence": {
      "type": "string",
      "maxLength": 13981016,
      "format": "base64",
      "contentEncoding": "base64",
      "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
    }
  },
  "required": [
    "opsAccount",
    "jurisdiction",
    "barNumber",
    "status",
    "url",
    "evidence"
  ],
  "additionalProperties": false
}
