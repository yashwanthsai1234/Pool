{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "message": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "string",
          "maxLength": 174764,
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
        },
        "signatures": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "properties": {
                "keyid": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
                },
                "sig": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$"
                }
              },
              "required": [
                "keyid",
                "sig"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "keyid": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
                },
                "sig": {
                  "type": "string",
                  "pattern": "^(?:[A-Za-z0-9+/]{4}){1103}$"
                }
              },
              "required": [
                "keyid",
                "sig"
              ],
              "additionalProperties": false
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "payload",
        "key_id",
        "signatures"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sessionId",
    "message"
  ],
  "additionalProperties": false
}
