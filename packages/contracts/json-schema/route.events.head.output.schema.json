{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nextSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prevHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "nextSeq",
    "prevHash"
  ],
  "additionalProperties": false
}
