{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "exists"
      ]
    }
  },
  "required": [
    "keyId",
    "status"
  ],
  "additionalProperties": false
}
