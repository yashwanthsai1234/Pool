{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "afterSeq": {
      "type": "integer",
      "minimum": -1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "sessionId",
    "recipient",
    "afterSeq"
  ],
  "additionalProperties": false
}
