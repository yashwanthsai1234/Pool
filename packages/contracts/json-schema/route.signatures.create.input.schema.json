{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dealId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "pay_bob",
        "refund_alice",
        "close",
        "ticket_create",
        "signer_list_update",
        "seal_update",
        "escrow_finish"
      ]
    }
  },
  "required": [
    "dealId",
    "purpose"
  ],
  "additionalProperties": false
}
