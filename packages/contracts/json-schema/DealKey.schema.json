        },
        "ops_bind_sig_ops": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2}){64,72}$"
        },
        "ops_bind_sig_lawyer": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "xrpl_pubkey",
