{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "xrpl_pubkey": {
          "type": "string",
          "pattern": "^ED[0-9A-F]{64}$"
        },
        "xrpl_account": {
          "type": "string",
          "pattern": "^r[1-9A-HJ-NP-Za-km-z]{24,34}$"
        },
        "commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_sig": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "slot_policy": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pq_key_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "enum": [
            "alice",
            "bob"
          ]
        },
        "id_method": {
          "type": "string",
          "enum": [
            "zkpassport",
            "nfc-chip"
          ]
        }
      },
      "required": [
        "xrpl_pubkey",
        "xrpl_account",
        "commitment",
        "binding_sig",
        "slot_policy",
        "pq_key_hash",
        "role",
        "id_method"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
