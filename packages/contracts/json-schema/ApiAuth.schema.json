{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledgerIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "signatures": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "keyid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
            },
            "sig": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$"
            }
          },
          "required": [
            "keyid",
            "sig"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "keyid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/#-]{1,128}$"
            },
            "sig": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4}){1103}$"
            }
          },
          "required": [
            "keyid",
            "sig"
          ],
          "additionalProperties": false
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "nonce",
    "ledgerIndex",
    "signatures"
  ],
  "additionalProperties": false
}
