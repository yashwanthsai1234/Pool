{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "stored"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "leafHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "DRAFT",
            "CONTRACT_SIGNED",
            "SHELL_OPEN",
            "QUARANTINED",
            "KEYS_READY",
            "WALLET_LOCKED",
            "VERIFIED",
            "SHIPPED",
            "RECEIVED",
            "FUNDED",
            "PAID_OUT",
            "REFUNDED",
            "DISPUTED",
            "EXPIRED",
            "CLOSED"
          ]
        }
      },
      "required": [
        "status",
        "seq",
        "leafHash",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "seq_taken"
        },
        "head": {
          "type": "object",
          "properties": {
            "nextSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "prevHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "nextSeq",
            "prevHash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "head"
      ],
      "additionalProperties": false
    }
  ]
}
